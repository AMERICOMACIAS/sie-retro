    {
      "parameters": {
        "jsCode": "\nconst entrada = $input.first().json;\nconst payload = entrada.body ?? entrada;\nconst datos = payload.data ?? {};\n\nconst errores = [];\n\nconst idValido = (id) =>\n  Number.isInteger(id) && id > 0;\n\nconst eventId = payload.event_id;\nconst orderId = payload.order_id ?? datos.order_id ?? null;\n\nconst subject = typeof datos.subject === 'string'\n  ? datos.subject.trim()\n  : '';\n\nconst message = typeof datos.message === 'string'\n  ? datos.message.trim()\n  : '';\n\n// Validar contrato\nif (payload.schema_version !== '1.0') {\n  errores.push('schema_version incorrecta');\n}\n\nif (payload.event_type !== 'support.requested') {\n  errores.push('event_type no válido');\n}\n\nif (!idValido(eventId)) {\n  errores.push('event_id no válido');\n}\n\nif (\n  typeof payload.occurred_at !== 'string' ||\n  Number.isNaN(Date.parse(payload.occurred_at))\n) {\n  errores.push('Fecha no válida');\n}\n\n// El pedido es opcional\nif (orderId !== null && !idValido(orderId)) {\n  errores.push('order_id no válido');\n}\n\n// Validar contenido\nif (!subject) {\n  errores.push('Falta el asunto');\n}\n\nif (!message) {\n  errores.push('Falta el mensaje');\n}\n\nreturn [{\n  json: {\n    valid: errores.length === 0,\n    errors: errores,\n    incident_id: idValido(eventId)\n      ? `INC-${eventId}`\n      : null,\n    event_id: eventId ?? null,\n    event_type: payload.event_type ?? null,\n    occurred_at: payload.occurred_at ?? null,\n    order_id: orderId,\n    subject,\n    message,\n    status: 'received',\n    source: 'woocommerce'\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
