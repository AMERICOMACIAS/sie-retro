      "id": "8fa09d38-6d81-4fc9-b1ff-cbafd8e016e4",
      "name": "Enrutar tipo de evento"
    },
    {
      "parameters": {
        "jsCode": "\nconst payload = $input.first().json.body ?? {};\nconst pedido = payload.data ?? {};\nconst cliente = pedido.customer ?? {};\nconst items = Array.isArray(pedido.items) ? pedido.items : [];\nconst errores = [];\n\n// Funciones auxiliares\nconst idValido = (id) => Number.isInteger(id) && id > 0;\n\nconst importe = (valor) => {\n  if (typeof valor !== 'string' ||\n      !/^\\d+(\\.\\d{1,2})?$/.test(valor.trim())) {\n    return null;\n  }\n  return Number(valor);\n};\n\n// 1. Validar el contrato JSON v1.0\nif (payload.schema_version !== '1.0') {\n  errores.push('schema_version incorrecta');\n}\n\nif (!idValido(payload.event_id)) {\n  errores.push('event_id no válido');\n}\n\nif (payload.event_type !== 'order.created') {\n  errores.push('event_type no válido');\n}\n\nif (!payload.occurred_at ||\n    Number.isNaN(Date.parse(payload.occurred_at))) {\n  errores.push('Fecha no válida');\n}\n\nif (!idValido(payload.order_id)) {\n  errores.push('order_id no válido');\n}\n\n// 2. Validar los datos del pedido\nif (!pedido.status) {\n  errores.push('Falta estado del pedido');\n}\n\nif (typeof pedido.currency !== 'string' ||\n    !/^[A-Z]{3}$/.test(pedido.currency)) {\n  errores.push('Moneda no válida');\n}\n\nconst total = importe(pedido.total);\nif (total === null) {\n  errores.push('Importe total no válido');\n}\n\n// 3. Validar el cliente (admite invitados)\nif (cliente.id !== null && !idValido(cliente.id)) {\n  errores.push('ID de cliente no válido');\n}\n\nif (typeof cliente.name !== 'string' ||\n    !cliente.name.trim()) {\n  errores.push('Falta nombre del cliente');\n}\n\nif (typeof cliente.email !== 'string' ||\n    !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(cliente.email)) {\n  errores.push('Email de cliente no válido');\n}\n\n// 4. Validar los productos (SKU puede estar vacío)\nif (items.length === 0) {\n  errores.push('Pedido sin productos');\n}\n\nfor (const item of items) {\n  if (!idValido(item?.product_id)) {\n    errores.push('product_id no válido');\n  }\n\n  if (typeof item?.sku !== 'string') {\n    errores.push('SKU no válido');\n  }\n\n  if (typeof item?.name !== 'string' || !item.name.trim()) {\n    errores.push('Nombre de producto no válido');\n  }\n\n  if (!idValido(item?.quantity)) {\n    errores.push('Cantidad no válida');\n  }\n\n  if (importe(item?.total) === null) {\n    errores.push('Total de línea no válido');\n  }\n}\n\n// 5. Preparar los campos para Google Sheets\nconst items_summary = items\n  .map(item => `${item?.name ?? 'Producto'} x${item?.quantity ?? 0}`)\n  .join(', ');\n\nreturn [{\n  json: {\n    valid: errores.length === 0,\n    errors: errores,\n    schema_version: payload.schema_version ?? null,\n    event_id: payload.event_id ?? null,\n    event_type: payload.event_type ?? null,\n    occurred_at: payload.occurred_at ?? null,\n    order_id: payload.order_id ?? null,\n    order_number: pedido.order_number ?? null,\n    status: pedido.status ?? null,\n    currency: pedido.currency ?? null,\n    total: total,\n    customer_id: cliente.id ?? null,\n    customer_name: cliente.name ?? null,\n    customer_email: cliente.email ?? null,\n    payment_method: pedido.payment_method ?? null,\n    items_summary: items_summary,\n    items: items.map(item => ({\n      product_id: item?.product_id ?? null,\n      sku: item?.sku ?? '',\n      name: item?.name ?? null,\n      quantity: item?.quantity ?? null,\n      total: importe(item?.total)\n    }))\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        -112
      ],
      "id": "e13777fd-d5d4-4fbc-8906-3e2f776be257",
      "name": "Validar pedido creado"
    },
    {
      "parameters": {
        "jsCode": "\nconst entrada = $input.first().json;\nconst payload = entrada.body ?? entrada;\nconst datos = payload.data ?? {};\nconst errores = [];\n\nconst idValido = (id) =>\n  Number.isInteger(id) && id > 0;\n\nconst estadoValido = (estado) =>\n  typeof estado === 'string' &&\n  /^[a-z][a-z0-9_-]*$/.test(estado);\n\n// Validar contrato común\nif (payload.schema_version !== '1.0') {\n  errores.push('schema_version incorrecta');\n}\n\nif (payload.event_type !== 'order.status_changed') {\n  errores.push('event_type incorrecto');\n}\n\nif (!idValido(payload.event_id)) {\n  errores.push('event_id no válido');\n}\n\nif (!idValido(payload.order_id)) {\n  errores.push('order_id no válido');\n}\n\nif (\n  typeof payload.occurred_at !== 'string' ||\n  Number.isNaN(Date.parse(payload.occurred_at))\n) {\n  errores.push('Fecha no válida');\n}\n\n// Validar cambio de estado\nif (!estadoValido(datos.previous_status)) {\n  errores.push('Estado anterior no válido');\n}\n\nif (!estadoValido(datos.status)) {\n  errores.push('Estado nuevo no válido');\n}\n\nif (\n  estadoValido(datos.previous_status) &&\n  estadoValido(datos.status) &&\n  datos.previous_status === datos.status\n) {\n  errores.push('No existe cambio de estado');\n}\n\n// Preparar salida\nreturn [{\n  json: {\n    valid: errores.length === 0,\n    errors: errores,\n    schema_version: payload.schema_version ?? null,\n    event_id: payload.event_id ?? null,\n    event_type: payload.event_type ?? null,\n    occurred_at: payload.occurred_at ?? null,\n    order_id: payload.order_id ?? null,\n    previous_status: datos.previous_status ?? null,\n    status: datos.status ?? null\n  }\n}];\n"
      },
